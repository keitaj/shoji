circuits/target/
# Prover.toml holds the private witness.
Prover.toml
*.db
*.db-journal
/bin/

# Mock CA / holder keys and certificates, and the Noir fixtures derived from
# them. Generated locally by `make fixtures`; never commit them: anyone holding
# a published mock CA key could forge certificates for a verifier that trusts it.
/testdata/
/circuits/*/src/fixtures.nr

# iOS card probe: generated project and build output.
/ios/*.xcodeproj/
/ios/**/.build/
/ios/**/.swiftpm/
xcuserdata/
# Real certificates must never be committed. Keep them outside the repository;
# these patterns are only a last line of defence.
*.der
/real/

# On-device prover: fetched/built artifacts and local signing settings.
/prover/target/
/prover/vendor/
/ios/ShojiProverKit/ShojiProverFFI.xcframework/
/ios/App/ProverResources/
/ios/Local.xcconfig
/ios/build/
